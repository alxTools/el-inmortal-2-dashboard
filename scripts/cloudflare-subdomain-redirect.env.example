# Cloudflare subdomain redirect reusable config
# This file is safe to commit (no secrets).

CF_ZONE_NAME=galantealx.com
CF_RECORD_NAME=code
CF_CNAME_TARGET=ei2.galantealx.com
CF_REDIRECT_URL=https://ei2.galantealx.com/tools/code-editor
CF_REDIRECT_STATUS=301
CF_PROXY=true
CF_PRESERVE_QUERY_STRING=false

# Optional ruleset/rule labels
RULESET_NAME=Managed dynamic redirects

# Optional auth overrides (recommended via root .env instead)
# CLOUDFLARE_API_TOKEN=cf-api-token-with-zone-permissions
# GLOBAL_API_KEY=cloudflare-global-api-key
# CF_EMAIL=you@domain.com

# Optional root env path
# ROOT_ENV_FILE=/workspace/.env
