{
  "openapi": "3.1.0",
  "info": {
    "title": "Paperclip Mission Gateway API",
    "version": "1.0.0",
    "description": "Gateway to dispatch missions to Paperclip with optional OpenCode fallback. Supports fire-and-forget for voice-driven workflows."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Local mission gateway"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getGatewayHealth",
        "summary": "Get gateway health",
        "security": [],
        "responses": {
          "200": {
            "description": "Gateway health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/missions": {
      "post": {
        "operationId": "startMission",
        "summary": "Start mission (synchronous dispatch response)",
        "description": "Dispatch a mission to Paperclip; may fallback to OpenCode depending on gateway config.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MissionRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Mission accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissionAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid mission payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/missions/fire-and-forget": {
      "post": {
        "operationId": "enqueueMission",
        "summary": "Enqueue mission (voice fire-and-forget)",
        "description": "Accepts JSON or text/plain mission input and executes asynchronously.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MissionRequest"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string",
                "description": "Raw mission instruction transcript"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Mission queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissionQueuedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid mission payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/missions/{missionId}/status": {
      "get": {
        "operationId": "getMissionStatus",
        "summary": "Get mission status",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mission state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissionStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Mission not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "MissionRequest": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "mission_id": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "transcript": {
            "type": "string"
          },
          "constraints": {
            "type": "object",
            "additionalProperties": true
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "goal"
            ]
          },
          {
            "required": [
              "prompt"
            ]
          },
          {
            "required": [
              "task"
            ]
          },
          {
            "required": [
              "instruction"
            ]
          },
          {
            "required": [
              "input"
            ]
          },
          {
            "required": [
              "transcript"
            ]
          }
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          },
          "paperclip_configured": {
            "type": "boolean"
          },
          "opencode_fallback_enabled": {
            "type": "boolean"
          },
          "api_key_required": {
            "type": "boolean"
          },
          "opencode_base_url": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "service"
        ]
      },
      "MissionAcceptedResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "mission_id": {
            "type": "string"
          },
          "paperclip": {
            "type": "object",
            "additionalProperties": true
          },
          "fallback": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "success",
          "mission_id"
        ]
      },
      "MissionQueuedResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "accepted": {
            "type": "boolean"
          },
          "mission_id": {
            "type": "string"
          },
          "status_url": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "accepted",
          "mission_id",
          "status_url"
        ]
      },
      "MissionStatusResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "mission_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "updated_at": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "additionalProperties": true
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "mission_id",
          "status",
          "updated_at"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    }
  }
}
