<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        .mvd-shell {
            padding-top: 24px;
            padding-bottom: 20px;
        }

        .mvd-panel {
            border: 1px solid rgba(130, 170, 240, 0.35);
            border-radius: 14px;
            padding: 16px;
            background: linear-gradient(180deg, #09182f 0%, #071121 100%);
            box-shadow: 0 20px 50px rgba(7, 18, 38, 0.45);
        }

        .mvd-copy {
            margin: 0 0 12px;
            color: #9fb8da;
        }

        .mvd-warning {
            margin: 0 0 12px;
            color: #ffd89a;
            font-size: 0.92rem;
        }

        .mvd-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 12px;
        }

        .mvd-frame-wrap {
            position: relative;
            border: 1px solid rgba(130, 170, 240, 0.28);
            border-radius: 12px;
            overflow: hidden;
            background: #050b15;
            min-height: 74vh;
        }

        .mvd-frame {
            width: 100%;
            height: 74vh;
            border: 0;
            display: block;
            background: #050b15;
        }

        .mvd-frame-fallback {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 20px;
            text-align: center;
            background: rgba(5, 11, 21, 0.9);
            color: #d7e6ff;
        }

        .mvd-frame-fallback.is-hidden {
            display: none;
        }

        @media (max-width: 900px) {
            .mvd-frame-wrap,
            .mvd-frame {
                min-height: 78vh;
                height: 78vh;
            }
        }
    </style>
</head>
<body class="dashboard-view density-compact mission-control-mode page-tools page-tools-ai-music-video-director">
    <%- include('../partials/navbar') %>

    <div class="container mvd-shell">
        <div class="mission-strip tools-mission-strip" aria-label="Estado AI Music Video Director">
            <span class="mission-chip mission-chip-live">VIDEO LAB ACTIVE</span>
            <span class="mission-chip">AI STORYBOARD</span>
            <span class="mission-chip">MUSIC VIDEO OPS</span>
        </div>

        <section class="mvd-panel">
            <div class="section-header">
                <h2><span class="section-icon">🎥</span> AI Music Video Director</h2>
                <a href="/tools" class="btn btn-ghost">Volver a Tools</a>
            </div>

            <p class="mvd-copy">
                Tool embebido dentro del dashboard para trabajar sin perder el header ni la navegacion.
            </p>
            <p class="mvd-warning">
                Si el navegador bloquea el iframe por seguridad, usa "Abrir en nueva pestana".
            </p>

            <div class="mvd-actions">
                <a href="<%= aiMusicVideoDirectorUrl %>" class="btn" target="_blank" rel="noreferrer">Abrir en nueva pestana</a>
            </div>

            <div class="mvd-frame-wrap">
                <iframe
                    id="mvdFrame"
                    class="mvd-frame"
                    src="<%= aiMusicVideoDirectorUrl %>"
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                ></iframe>
                <div id="mvdFallback" class="mvd-frame-fallback is-hidden">
                    <strong>No fue posible cargar AI Music Video Director embebido.</strong>
                    <span>El sitio puede restringir iframes por politicas de seguridad.</span>
                    <a href="<%= aiMusicVideoDirectorUrl %>" class="btn" target="_blank" rel="noreferrer">Abrir AI Music Video Director</a>
                </div>
            </div>
        </section>
    </div>

    <%- include('../partials/footer') %>

    <script>
        (function () {
            const frame = document.getElementById('mvdFrame');
            const fallback = document.getElementById('mvdFallback');

            if (!frame || !fallback) {
                return;
            }

            let frameLoaded = false;

            frame.addEventListener('load', function () {
                frameLoaded = true;
                fallback.classList.add('is-hidden');
            });

            window.setTimeout(function () {
                let frameBlocked = !frameLoaded;

                if (!frameBlocked) {
                    try {
                        const href = frame.contentWindow && frame.contentWindow.location
                            ? String(frame.contentWindow.location.href || '')
                            : '';
                        if (!href || href === 'about:blank') {
                            frameBlocked = true;
                        }
                    } catch (_) {
                        frameBlocked = false;
                    }
                }

                if (frameBlocked) {
                    fallback.classList.remove('is-hidden');
                }
            }, 5000);
        })();
    </script>
</body>
</html>
