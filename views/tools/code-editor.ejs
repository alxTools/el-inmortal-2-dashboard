<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        .vscode-shell {
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 14px;
            background: rgba(2, 6, 23, 0.78);
            padding: 12px;
            margin-bottom: 14px;
        }

        .vscode-toolbar {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 10px;
        }

        .vscode-toolbar-title {
            color: #f8fafc;
            font-size: 0.96rem;
            font-weight: 700;
            margin: 0 0 3px;
        }

        .vscode-toolbar-subtitle {
            color: #94a3b8;
            font-size: 0.78rem;
            margin: 0;
        }

        .vscode-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
            flex-wrap: wrap;
        }

        .vscode-status {
            min-height: 20px;
            margin-bottom: 10px;
            color: #94a3b8;
            font-size: 0.82rem;
        }

        .vscode-status.success {
            color: #86efac;
        }

        .vscode-status.warn {
            color: #fde68a;
        }

        .vscode-status.error {
            color: #fca5a5;
        }

        .vscode-frame {
            width: 100%;
            min-height: 74vh;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: #020617;
        }

        .editor-layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 14px;
            align-items: start;
            margin-top: 12px;
        }

        .editor-panel {
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            background: rgba(2, 6, 23, 0.75);
            padding: 12px;
        }

        .path-box {
            margin: 8px 0;
            font-size: 0.76rem;
            color: #a5b4fc;
            line-height: 1.4;
            border: 1px solid rgba(99, 102, 241, 0.32);
            border-radius: 8px;
            padding: 8px;
            background: rgba(99, 102, 241, 0.1);
            word-break: break-all;
        }

        .path-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 10px;
        }

        .path-input {
            width: 100%;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            background: rgba(15, 23, 42, 0.85);
            color: #f8fafc;
            padding: 8px 10px;
            font-size: 0.82rem;
            margin-bottom: 8px;
        }

        .file-list {
            margin: 10px 0 0;
            padding: 0;
            list-style: none;
            max-height: 68vh;
            overflow: auto;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(15, 23, 42, 0.6);
        }

        .file-list-item {
            display: flex;
            gap: 8px;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding: 8px;
            font-size: 0.78rem;
        }

        .file-list-item:last-child {
            border-bottom: none;
        }

        .file-entry-btn {
            border: none;
            background: transparent;
            color: #e2e8f0;
            text-align: left;
            cursor: pointer;
            width: 100%;
            font-size: 0.78rem;
            padding: 0;
            font-family: inherit;
            word-break: break-word;
        }

        .file-entry-btn:hover {
            color: #7dd3fc;
        }

        .file-entry-meta {
            color: #64748b;
            font-size: 0.7rem;
            white-space: nowrap;
        }

        .empty-list {
            color: #94a3b8;
            font-size: 0.8rem;
            padding: 16px;
            text-align: center;
        }

        .editor-main-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 10px;
        }

        .current-file {
            color: #facc15;
            font-size: 0.82rem;
            word-break: break-all;
            font-family: monospace;
        }

        .toolbar-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .editor-status {
            min-height: 18px;
            margin-bottom: 8px;
            color: #94a3b8;
            font-size: 0.8rem;
        }

        .editor-status.success {
            color: #86efac;
        }

        .editor-status.error {
            color: #fca5a5;
        }

        .editor-status.warn {
            color: #fde68a;
        }

        #code-editor-surface {
            width: 100%;
            min-height: 72vh;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            overflow: hidden;
        }

        .code-editor-textarea {
            width: 100%;
            min-height: 72vh;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: #0b1220;
            color: #e2e8f0;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
            font-size: 13px;
            line-height: 1.4;
            padding: 10px;
            resize: vertical;
            display: none;
        }

        .editor-footer-note {
            margin-top: 8px;
            color: #64748b;
            font-size: 0.72rem;
        }

        .manual-editor-shell {
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            background: rgba(2, 6, 23, 0.6);
            padding: 10px;
        }

        .manual-editor-shell > summary {
            cursor: pointer;
            color: #bfdbfe;
            font-weight: 700;
            font-size: 0.84rem;
            user-select: none;
        }

        @media (max-width: 980px) {
            .editor-layout {
                grid-template-columns: 1fr;
            }

            .file-list {
                max-height: 34vh;
            }

            #code-editor-surface,
            .vscode-frame {
                min-height: 62vh;
            }
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.6/ace.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container" style="padding-top: 30px;">
        <section class="section">
            <div class="section-header">
                <h2><span class="section-icon">🧑‍💻</span> Code Editor</h2>
                <a href="/tools" class="btn btn-secondary">Volver a Tools</a>
            </div>

            <p style="color:#94a3b8; margin-bottom: 10px;">
                VS Code Web en Docker persistente embebido en el dashboard. Debajo queda el editor ligero como fallback rapido.
            </p>

            <div class="vscode-shell">
                <div class="vscode-toolbar">
                    <div>
                        <p class="vscode-toolbar-title">VS Code Web (Container: <%= codeServerContainerName %>)</p>
                        <p class="vscode-toolbar-subtitle">Proxy local: <code>/tools/code-editor/vscode/ide/</code> | Host interno: <%= codeServerHost %>:<%= codeServerPort %></p>
                    </div>
                    <div class="vscode-actions">
                        <button id="vscode-start-btn" class="btn">Start Container</button>
                        <button id="vscode-restart-btn" class="btn btn-secondary">Restart</button>
                        <button id="vscode-stop-btn" class="btn btn-secondary">Stop</button>
                        <button id="vscode-open-tab-btn" class="btn btn-secondary">Open in Tab</button>
                    </div>
                </div>

                <div id="vscode-status" class="vscode-status">Consultando estado de VS Code...</div>
                <iframe
                    id="vscode-frame"
                    class="vscode-frame"
                    title="VS Code Web"
                    src="about:blank"
                    loading="lazy"
                    referrerpolicy="same-origin"
                    allow="clipboard-read; clipboard-write"
                ></iframe>
            </div>

            <details class="manual-editor-shell">
                <summary>Editor ligero integrado (fallback)</summary>

                <div class="editor-layout">
                    <aside class="editor-panel">
                        <strong style="color:#f8fafc; font-size:0.85rem;">Project Root</strong>
                        <div class="path-box"><%= editorRoot %></div>

                        <input id="path-input" class="path-input" type="text" placeholder="Ruta relativa (ej: src/routes/tools.js)">
                        <div class="path-actions">
                            <button id="open-path-btn" class="btn">Abrir Path</button>
                            <button id="open-root-btn" class="btn btn-secondary">Root</button>
                            <button id="refresh-dir-btn" class="btn btn-secondary">Recargar</button>
                        </div>

                        <ul id="file-list" class="file-list">
                            <li class="empty-list">Cargando archivos...</li>
                        </ul>
                    </aside>

                    <main class="editor-panel">
                        <div class="editor-main-toolbar">
                            <div id="current-file" class="current-file">Sin archivo abierto</div>
                            <div class="toolbar-actions">
                                <button id="reload-file-btn" class="btn btn-secondary">Reload File</button>
                                <button id="save-file-btn" class="btn">Guardar (Ctrl+S)</button>
                            </div>
                        </div>

                        <div id="editor-status" class="editor-status"></div>
                        <div id="code-editor-surface"></div>
                        <textarea id="code-editor-textarea" class="code-editor-textarea" spellcheck="false"></textarea>
                        <div class="editor-footer-note">
                            Limite por archivo: <strong id="max-size-label"></strong>. No se abren binarios.
                        </div>
                    </main>
                </div>
            </details>
        </section>
    </div>

    <%- include('../partials/footer') %>

    <script>
        (() => {
            const MAX_BYTES = Number('<%= Number(maxBytes || 0) %>') || (2 * 1024 * 1024);
            const CODE_SERVER_PROXY_PATH = '<%= codeServerProxyPath %>';
            const CODE_SERVER_STATUS_API = '/tools/code-editor/vscode/status';
            const CODE_SERVER_START_API = '/tools/code-editor/vscode/start';
            const CODE_SERVER_RESTART_API = '/tools/code-editor/vscode/restart';
            const CODE_SERVER_STOP_API = '/tools/code-editor/vscode/stop';

            const vscodeFrameEl = document.getElementById('vscode-frame');
            const vscodeStatusEl = document.getElementById('vscode-status');
            const vscodeStartBtn = document.getElementById('vscode-start-btn');
            const vscodeRestartBtn = document.getElementById('vscode-restart-btn');
            const vscodeStopBtn = document.getElementById('vscode-stop-btn');
            const vscodeOpenTabBtn = document.getElementById('vscode-open-tab-btn');

            const listEl = document.getElementById('file-list');
            const pathInput = document.getElementById('path-input');
            const openPathBtn = document.getElementById('open-path-btn');
            const openRootBtn = document.getElementById('open-root-btn');
            const refreshDirBtn = document.getElementById('refresh-dir-btn');
            const reloadFileBtn = document.getElementById('reload-file-btn');
            const saveFileBtn = document.getElementById('save-file-btn');
            const currentFileEl = document.getElementById('current-file');
            const statusEl = document.getElementById('editor-status');
            const maxSizeLabelEl = document.getElementById('max-size-label');
            const editorSurfaceEl = document.getElementById('code-editor-surface');
            const editorTextareaEl = document.getElementById('code-editor-textarea');

            const hasAce = Boolean(window.ace && typeof window.ace.edit === 'function');
            let editor;

            if (hasAce) {
                editor = ace.edit('code-editor-surface');
                editor.setTheme('ace/theme/one_dark');
                editor.session.setMode('ace/mode/text');
                editor.session.setUseWrapMode(false);
                editor.setShowPrintMargin(false);
                editor.setOptions({
                    fontSize: '14px',
                    tabSize: 2,
                    useSoftTabs: true,
                    showInvisibles: false
                });
            } else {
                editorSurfaceEl.style.display = 'none';
                editorTextareaEl.style.display = 'block';

                editor = {
                    getValue() {
                        return editorTextareaEl.value;
                    },
                    setValue(nextValue) {
                        editorTextareaEl.value = String(nextValue || '');
                        editorTextareaEl.scrollTop = 0;
                    },
                    session: {
                        setMode() {},
                        setUseWrapMode() {},
                        on(eventName, handler) {
                            if (eventName === 'change') {
                                editorTextareaEl.addEventListener('input', handler);
                            }
                        }
                    }
                };
            }

            let codeServerRunning = false;
            let codeServerFrameLoaded = false;
            let currentDirectory = '';
            let currentFilePath = '';
            let originalContent = '';
            let isDirty = false;

            function normalizeInputPath(rawValue) {
                return String(rawValue || '')
                    .replace(/\\/g, '/')
                    .replace(/^\/+/, '')
                    .trim();
            }

            function formatBytes(bytes) {
                const value = Number(bytes || 0);
                if (!Number.isFinite(value) || value <= 0) return '0 B';
                if (value < 1024) return `${value} B`;
                if (value < (1024 * 1024)) return `${(value / 1024).toFixed(1)} KB`;
                return `${(value / (1024 * 1024)).toFixed(2)} MB`;
            }

            function setStatus(message, tone) {
                statusEl.textContent = message || '';
                statusEl.className = 'editor-status';
                if (tone) {
                    statusEl.classList.add(tone);
                }
            }

            function setVsCodeStatus(message, tone) {
                vscodeStatusEl.textContent = message || '';
                vscodeStatusEl.className = 'vscode-status';
                if (tone) {
                    vscodeStatusEl.classList.add(tone);
                }
            }

            function setVsCodeButtonsDisabled(disabled) {
                const value = Boolean(disabled);
                vscodeStartBtn.disabled = value;
                vscodeRestartBtn.disabled = value;
                vscodeStopBtn.disabled = value;
            }

            function getVsCodeFrameUrl() {
                const separator = CODE_SERVER_PROXY_PATH.includes('?') ? '&' : '?';
                return `${CODE_SERVER_PROXY_PATH}${separator}folder=/workspace`;
            }

            function loadVsCodeFrame(forceReload = false) {
                if (!codeServerRunning) {
                    vscodeFrameEl.src = 'about:blank';
                    codeServerFrameLoaded = false;
                    return;
                }

                if (codeServerFrameLoaded && !forceReload) {
                    return;
                }

                const targetUrl = getVsCodeFrameUrl();
                const withCacheBust = `${targetUrl}${targetUrl.includes('?') ? '&' : '?'}_ts=${Date.now()}`;
                vscodeFrameEl.src = withCacheBust;
                codeServerFrameLoaded = true;
            }

            async function parseJsonSafe(response) {
                const raw = await response.text();
                try {
                    return JSON.parse(raw);
                } catch (_) {
                    return {
                        success: false,
                        error: raw || `http_${response.status}`
                    };
                }
            }

            async function refreshCodeServerStatus() {
                const response = await fetch(CODE_SERVER_STATUS_API, { credentials: 'same-origin' });
                const payload = await parseJsonSafe(response);

                if (!response.ok || !payload.success) {
                    codeServerRunning = false;
                    codeServerFrameLoaded = false;
                    vscodeFrameEl.src = 'about:blank';
                    setVsCodeStatus(`No se pudo consultar status: ${payload.error || response.status}`, 'error');
                    return;
                }

                codeServerRunning = payload.running === true;

                if (codeServerRunning) {
                    setVsCodeStatus(`VS Code online (${payload.status || 'running'}).`, 'success');
                    loadVsCodeFrame(false);
                } else {
                    setVsCodeStatus(`VS Code offline (${payload.status || 'stopped'}). Usa Start Container.`, 'warn');
                    codeServerFrameLoaded = false;
                    vscodeFrameEl.src = 'about:blank';
                }
            }

            async function callCodeServerControlApi(url, bodyPayload, loadingMessage) {
                setVsCodeButtonsDisabled(true);
                setVsCodeStatus(loadingMessage, 'warn');

                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(bodyPayload || {})
                    });

                    const payload = await parseJsonSafe(response);
                    if (!response.ok || !payload.success) {
                        setVsCodeStatus(`Operacion fallida: ${payload.error || payload.message || response.status}`, 'error');
                        await refreshCodeServerStatus();
                        return;
                    }

                    setVsCodeStatus(payload.message || 'Operacion completada.', 'success');
                    await refreshCodeServerStatus();
                } finally {
                    setVsCodeButtonsDisabled(false);
                }
            }

            function updateCurrentFileLabel() {
                if (!currentFilePath) {
                    currentFileEl.textContent = 'Sin archivo abierto';
                    return;
                }

                currentFileEl.textContent = `${isDirty ? '* ' : ''}${currentFilePath}`;
            }

            function setDirty(value) {
                isDirty = Boolean(value);
                updateCurrentFileLabel();
            }

            function modeFromPath(filePath) {
                const fileName = String(filePath || '').split('/').pop() || '';
                if (!fileName) return 'text';

                if (fileName === 'Dockerfile') return 'dockerfile';
                if (fileName === '.env') return 'sh';

                const extension = fileName.includes('.')
                    ? fileName.split('.').pop().toLowerCase()
                    : '';

                const modes = {
                    js: 'javascript',
                    cjs: 'javascript',
                    mjs: 'javascript',
                    ts: 'typescript',
                    jsx: 'javascript',
                    tsx: 'typescript',
                    json: 'json',
                    md: 'markdown',
                    html: 'html',
                    ejs: 'html',
                    css: 'css',
                    scss: 'scss',
                    less: 'less',
                    yml: 'yaml',
                    yaml: 'yaml',
                    sh: 'sh',
                    sql: 'sql',
                    py: 'python',
                    txt: 'text',
                    log: 'text'
                };

                return modes[extension] || 'text';
            }

            function setEditorMode(filePath) {
                if (!hasAce) {
                    return;
                }
                const mode = modeFromPath(filePath);
                editor.session.setMode(`ace/mode/${mode}`);
            }

            function confirmDiscard() {
                if (!isDirty) return true;
                return window.confirm('Tienes cambios sin guardar. Deseas descartarlos?');
            }

            function renderDirectoryList(entries) {
                listEl.innerHTML = '';
                const safeEntries = Array.isArray(entries) ? entries : [];

                const appendEntry = (label, onClick, meta, isDim) => {
                    const item = document.createElement('li');
                    item.className = 'file-list-item';

                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'file-entry-btn';
                    button.textContent = label;
                    if (isDim) {
                        button.style.color = '#94a3b8';
                    }
                    button.addEventListener('click', onClick);

                    const metaEl = document.createElement('span');
                    metaEl.className = 'file-entry-meta';
                    metaEl.textContent = meta || '';

                    item.appendChild(button);
                    item.appendChild(metaEl);
                    listEl.appendChild(item);
                };

                if (currentDirectory) {
                    appendEntry('..', () => {
                        const parent = currentDirectory.includes('/')
                            ? currentDirectory.split('/').slice(0, -1).join('/')
                            : '';
                        loadDirectory(parent);
                    }, 'up', true);
                }

                safeEntries.forEach((entry) => {
                    const entryPath = String(entry.path || '');
                    const type = String(entry.type || 'file');
                    const icon = type === 'directory' ? '📁' : '📄';
                    const meta = type === 'directory' ? 'dir' : formatBytes(entry.size);

                    appendEntry(`${icon} ${entry.name}`, () => {
                        if (type === 'directory') {
                            loadDirectory(entryPath);
                        } else {
                            openFile(entryPath);
                        }
                    }, meta);
                });

                if (!currentDirectory && safeEntries.length === 0) {
                    listEl.innerHTML = '<li class="empty-list">No hay archivos visibles.</li>';
                    return;
                }

                if (safeEntries.length === 0 && currentDirectory) {
                    listEl.innerHTML += '<li class="empty-list">Directorio vacio.</li>';
                }
            }

            async function loadDirectory(rawPath) {
                const targetPath = normalizeInputPath(rawPath);

                setStatus(`Cargando directorio ${targetPath || '/'}...`);
                const response = await fetch(`/tools/code-editor/api/list?path=${encodeURIComponent(targetPath)}`, {
                    credentials: 'same-origin'
                });
                const payload = await parseJsonSafe(response);

                if (!response.ok || !payload.success) {
                    if ((payload.error || '').includes('not_a_directory') && targetPath) {
                        await openFile(targetPath);
                        return;
                    }

                    setStatus(`No se pudo abrir directorio: ${payload.error || response.status}`, 'error');
                    return;
                }

                currentDirectory = String(payload.currentPath || '');
                pathInput.value = currentDirectory;
                renderDirectoryList(payload.entries || []);
                setStatus(`Directorio cargado: ${currentDirectory || '/'}`, 'success');
            }

            async function openFile(rawPath) {
                const targetPath = normalizeInputPath(rawPath);
                if (!targetPath) {
                    setStatus('Selecciona un archivo valido.', 'error');
                    return;
                }

                if (currentFilePath !== targetPath && !confirmDiscard()) {
                    return;
                }

                setStatus(`Abriendo archivo: ${targetPath}...`);
                const response = await fetch(`/tools/code-editor/api/file?path=${encodeURIComponent(targetPath)}`, {
                    credentials: 'same-origin'
                });
                const payload = await parseJsonSafe(response);

                if (!response.ok || !payload.success) {
                    setStatus(`No se pudo abrir archivo: ${payload.error || response.status}`, 'error');
                    return;
                }

                currentFilePath = String(payload.path || targetPath);
                originalContent = String(payload.content || '');
                editor.setValue(originalContent, -1);
                setEditorMode(currentFilePath);
                setDirty(false);

                pathInput.value = currentFilePath;
                setStatus(`Archivo cargado (${formatBytes(payload.size)}).`, 'success');
            }

            async function saveCurrentFile() {
                if (!currentFilePath) {
                    setStatus('Abre un archivo antes de guardar.', 'warn');
                    return;
                }

                const content = editor.getValue();
                const payloadSize = new TextEncoder().encode(content).length;
                if (payloadSize > MAX_BYTES) {
                    setStatus(`El contenido excede el limite (${formatBytes(MAX_BYTES)}).`, 'error');
                    return;
                }

                saveFileBtn.disabled = true;
                setStatus(`Guardando ${currentFilePath}...`, 'warn');

                try {
                    const response = await fetch('/tools/code-editor/api/file', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            path: currentFilePath,
                            content
                        })
                    });

                    const payload = await parseJsonSafe(response);
                    if (!response.ok || !payload.success) {
                        setStatus(`No se pudo guardar: ${payload.error || response.status}`, 'error');
                        return;
                    }

                    originalContent = content;
                    setDirty(false);
                    setStatus(`Archivo guardado (${formatBytes(payload.size)}).`, 'success');
                } finally {
                    saveFileBtn.disabled = false;
                }
            }

            async function reloadCurrentFile() {
                if (!currentFilePath) {
                    setStatus('No hay archivo abierto para recargar.', 'warn');
                    return;
                }

                if (!confirmDiscard()) {
                    return;
                }

                await openFile(currentFilePath);
            }

            editor.session.on('change', () => {
                if (!currentFilePath) return;
                setDirty(editor.getValue() !== originalContent);
            });

            openPathBtn.addEventListener('click', () => {
                const value = normalizeInputPath(pathInput.value);
                if (!value) {
                    loadDirectory('');
                    return;
                }
                loadDirectory(value);
            });

            openRootBtn.addEventListener('click', () => {
                loadDirectory('');
            });

            refreshDirBtn.addEventListener('click', () => {
                loadDirectory(currentDirectory);
            });

            saveFileBtn.addEventListener('click', () => {
                saveCurrentFile();
            });

            reloadFileBtn.addEventListener('click', () => {
                reloadCurrentFile();
            });

            pathInput.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    openPathBtn.click();
                }
            });

            window.addEventListener('keydown', (event) => {
                const isSaveShortcut = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 's';
                if (!isSaveShortcut) return;
                event.preventDefault();
                saveCurrentFile();
            });

            vscodeStartBtn.addEventListener('click', async () => {
                await callCodeServerControlApi(CODE_SERVER_START_API, { force: false }, 'Iniciando container VS Code...');
                loadVsCodeFrame(true);
            });

            vscodeRestartBtn.addEventListener('click', async () => {
                await callCodeServerControlApi(CODE_SERVER_RESTART_API, {}, 'Reiniciando VS Code...');
                loadVsCodeFrame(true);
            });

            vscodeStopBtn.addEventListener('click', async () => {
                await callCodeServerControlApi(CODE_SERVER_STOP_API, {}, 'Deteniendo VS Code...');
            });

            vscodeOpenTabBtn.addEventListener('click', () => {
                window.open(getVsCodeFrameUrl(), '_blank', 'noopener');
            });

            maxSizeLabelEl.textContent = formatBytes(MAX_BYTES);
            if (hasAce) {
                setStatus('Cargando explorador de archivos...');
            } else {
                setStatus('ACE no cargo (bloqueado por CSP/red). Usando editor de texto fallback.', 'warn');
            }

            refreshCodeServerStatus().catch((error) => {
                setVsCodeStatus(`No se pudo consultar VS Code: ${error.message}`, 'error');
            });
            setInterval(() => {
                refreshCodeServerStatus().catch(() => {});
            }, 20000);

            loadDirectory('');
        })();
    </script>
</body>
</html>
