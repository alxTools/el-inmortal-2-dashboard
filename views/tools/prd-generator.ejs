<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        .prd-shell {
            padding-top: 24px;
            padding-bottom: 20px;
        }

        .prd-panel {
            border: 1px solid rgba(130, 170, 240, 0.35);
            border-radius: 14px;
            padding: 16px;
            background: linear-gradient(180deg, #09182f 0%, #071121 100%);
            box-shadow: 0 20px 50px rgba(7, 18, 38, 0.45);
        }

        .prd-copy {
            margin: 0 0 12px;
            color: #9fb8da;
        }

        .prd-warning {
            margin: 0 0 12px;
            color: #ffd89a;
            font-size: 0.92rem;
        }

        .prd-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 12px;
        }

        .prd-frame-wrap {
            position: relative;
            border: 1px solid rgba(130, 170, 240, 0.28);
            border-radius: 12px;
            overflow: hidden;
            background: #050b15;
            min-height: 74vh;
        }

        .prd-frame {
            width: 100%;
            height: 74vh;
            border: 0;
            display: block;
            background: #050b15;
        }

        .prd-frame-fallback {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 20px;
            text-align: center;
            background: rgba(5, 11, 21, 0.9);
            color: #d7e6ff;
        }

        .prd-frame-fallback.is-hidden {
            display: none;
        }

        @media (max-width: 900px) {
            .prd-frame-wrap,
            .prd-frame {
                min-height: 78vh;
                height: 78vh;
            }
        }
    </style>
</head>
<body class="dashboard-view density-compact mission-control-mode page-tools page-tools-prd-generator">
    <%- include('../partials/navbar') %>

    <div class="container prd-shell">
        <div class="mission-strip tools-mission-strip" aria-label="Estado PRD generator">
            <span class="mission-chip mission-chip-live">PRD LAB ACTIVE</span>
            <span class="mission-chip">CLAUDE ARTIFACT</span>
            <span class="mission-chip">DOC PLANNING</span>
        </div>

        <section class="prd-panel">
            <div class="section-header">
                <h2><span class="section-icon">📄</span> PRD Generator</h2>
                <a href="/tools" class="btn btn-ghost">Volver a Tools</a>
            </div>

            <p class="prd-copy">
                Artifact de Claude embebido para generar PRDs sin salir del dashboard.
            </p>
            <p class="prd-warning">
                Si Claude bloquea el embed por seguridad o sesion, usa "Abrir en nueva pestana".
            </p>

            <div class="prd-actions">
                <a href="<%= prdGeneratorUrl %>" class="btn" target="_blank" rel="noreferrer">Abrir en nueva pestana</a>
            </div>

            <div class="prd-frame-wrap">
                <iframe
                    id="prdFrame"
                    class="prd-frame"
                    src="<%= prdGeneratorEmbedUrl %>"
                    title="Claude Artifact PRD Generator"
                    loading="lazy"
                    frameborder="0"
                    allow="clipboard-write"
                    allowfullscreen
                    referrerpolicy="strict-origin-when-cross-origin"
                ></iframe>
                <div id="prdFallback" class="prd-frame-fallback is-hidden">
                    <strong>No fue posible cargar PRD Generator embebido.</strong>
                    <span>El artifact puede restringir iframes en algunas sesiones o navegadores.</span>
                    <a href="<%= prdGeneratorUrl %>" class="btn" target="_blank" rel="noreferrer">Abrir PRD Generator</a>
                </div>
            </div>
        </section>
    </div>

    <%- include('../partials/footer') %>

    <script>
        (function () {
            const frame = document.getElementById('prdFrame');
            const fallback = document.getElementById('prdFallback');

            if (!frame || !fallback) {
                return;
            }

            let frameLoaded = false;

            frame.addEventListener('load', function () {
                frameLoaded = true;
                fallback.classList.add('is-hidden');
            });

            window.setTimeout(function () {
                let frameBlocked = !frameLoaded;

                if (!frameBlocked) {
                    try {
                        const href = frame.contentWindow && frame.contentWindow.location
                            ? String(frame.contentWindow.location.href || '')
                            : '';
                        if (!href || href === 'about:blank') {
                            frameBlocked = true;
                        }
                    } catch (_) {
                        frameBlocked = false;
                    }
                }

                if (frameBlocked) {
                    fallback.classList.remove('is-hidden');
                }
            }, 5000);
        })();
    </script>
</body>
</html>
