<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        .ve-shell {
            padding-top: 24px;
            padding-bottom: 20px;
        }

        .ve-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }

        .ve-header h2 {
            margin: 0;
        }

        .ve-subtitle {
            margin: 8px 0 0;
            color: #8ea9d0;
            max-width: 820px;
        }

        .ve-back {
            text-decoration: none;
            color: #e2e8f0;
            border: 1px solid rgba(130, 170, 240, 0.35);
            border-radius: 8px;
            padding: 8px 12px;
            background: rgba(8, 20, 42, 0.75);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .ve-panel {
            border: 1px solid rgba(130, 170, 240, 0.35);
            border-radius: 14px;
            overflow: hidden;
            background: linear-gradient(180deg, #09182f 0%, #071121 100%);
            box-shadow: 0 20px 50px rgba(7, 18, 38, 0.45);
        }

        .ve-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-bottom: 1px solid rgba(130, 170, 240, 0.24);
            flex-wrap: wrap;
        }

        .ve-status-line {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #c9dbfb;
            font-weight: 600;
        }

        .ve-chip {
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        .ve-chip.running {
            color: #0f2f27;
            background: #67f1be;
        }

        .ve-chip.offline {
            color: #450f14;
            background: #fda4af;
        }

        .ve-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .ve-btn {
            border: 1px solid rgba(130, 170, 240, 0.35);
            border-radius: 8px;
            background: rgba(11, 28, 56, 0.9);
            color: #e2e8f0;
            padding: 8px 12px;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-weight: 600;
        }

        .ve-btn:hover {
            background: rgba(18, 42, 78, 0.95);
        }

        .ve-btn.primary {
            color: #ffffff;
            border-color: transparent;
            background: linear-gradient(135deg, #2f76ff, #16bfd8);
        }

        .ve-btn.warn {
            border-color: rgba(255, 190, 92, 0.6);
            color: #ffe2b4;
        }

        .ve-btn.danger {
            border-color: rgba(255, 111, 135, 0.7);
            color: #ffd0d8;
        }

        .ve-btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

        .ve-status-note {
            margin: 0;
            padding: 10px 12px;
            color: #9fb8da;
            border-bottom: 1px solid rgba(130, 170, 240, 0.2);
            font-size: 0.86rem;
        }

        .ve-health-row {
            margin: 0;
            padding: 8px 12px;
            border-bottom: 1px solid rgba(130, 170, 240, 0.15);
            color: #a8bfdd;
            font-size: 0.78rem;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .ve-health-item {
            border: 1px solid rgba(130, 170, 240, 0.22);
            border-radius: 999px;
            padding: 3px 10px;
            background: rgba(6, 18, 36, 0.65);
        }

        .ve-frame {
            width: 100%;
            height: min(78vh, 900px);
            border: 0;
            display: block;
            background: #050b15;
        }

        .ve-foot {
            margin: 12px 0 0;
            color: #8ea6c8;
            font-size: 13px;
            line-height: 1.5;
        }

        .ve-foot code {
            color: #c3ddff;
            background: rgba(8, 20, 40, 0.7);
            border: 1px solid rgba(130, 170, 240, 0.3);
            border-radius: 6px;
            padding: 2px 6px;
        }
    </style>
</head>
<body>
    <% const veStatus = (typeof status !== 'undefined' && status) ? status : {}; %>
    <%- include('../partials/navbar') %>

    <div class="container ve-shell">
        <div class="ve-header">
            <div>
                <h2><span class="section-icon">🎬</span> Kimu Video Editor (Docker)</h2>
                <p class="ve-subtitle">
                    Stack local del repo <strong>trykimu/videoeditor</strong> corriendo en Docker y expuesto por proxy interno.
                </p>
            </div>
            <a href="/tools" class="ve-back">← Volver a Tools</a>
        </div>

        <section class="ve-panel">
            <div class="ve-toolbar">
                <div class="ve-status-line">
                    <span id="ve-label">Estado del stack</span>
                    <span id="ve-chip" class="ve-chip <%= veStatus.running ? 'running' : 'offline' %>"><%= veStatus.running ? 'RUNNING' : 'OFFLINE' %></span>
                </div>

                <div class="ve-actions">
                    <button type="button" id="ve-start" class="ve-btn primary">▶ Start</button>
                    <button type="button" id="ve-restart" class="ve-btn warn">↻ Restart</button>
                    <button type="button" id="ve-stop" class="ve-btn danger">■ Stop</button>
                    <button type="button" id="ve-refresh" class="ve-btn">🔄 Recargar</button>
                    <a href="<%= repoUrl %>" target="_blank" rel="noreferrer" class="ve-btn">📚 Ver Repo</a>
                    <a id="ve-open-new" href="<%= proxyPath %>/" target="_blank" rel="noreferrer" class="ve-btn">↗ Abrir en nueva pestana</a>
                </div>
            </div>

            <p id="ve-note" class="ve-status-note">Preparando estado...</p>
            <p class="ve-health-row">
                <span id="ve-frontend" class="ve-health-item">frontend: --</span>
                <span id="ve-render" class="ve-health-item">render: --</span>
                <span id="ve-fastapi" class="ve-health-item">fastapi: --</span>
            </p>

            <iframe id="ve-frame" class="ve-frame" src="<%= veStatus.running ? proxyPath + '/' : 'about:blank' %>" loading="lazy"></iframe>
        </section>

        <p class="ve-foot">
            Proxy interno: <code><%= proxyPath %>/</code>.
            El start usa <code>scripts/video-editor/manage-video-editor.sh</code> y Docker Compose del repo.
        </p>
    </div>

    <%- include('../partials/footer') %>

    <script>
        (function () {
            const proxyPath = <%- JSON.stringify(proxyPath) %>;

            const frame = document.getElementById('ve-frame');
            const chip = document.getElementById('ve-chip');
            const note = document.getElementById('ve-note');
            const openNew = document.getElementById('ve-open-new');

            const startBtn = document.getElementById('ve-start');
            const restartBtn = document.getElementById('ve-restart');
            const stopBtn = document.getElementById('ve-stop');
            const refreshBtn = document.getElementById('ve-refresh');

            const frontendEl = document.getElementById('ve-frontend');
            const renderEl = document.getElementById('ve-render');
            const fastapiEl = document.getElementById('ve-fastapi');

            let pendingAction = false;

            function setBusy(busy) {
                pendingAction = Boolean(busy);
                startBtn.disabled = pendingAction;
                restartBtn.disabled = pendingAction;
                stopBtn.disabled = pendingAction;
            }

            function shortState(node) {
                if (!node) return 'missing';
                return `${node.state || 'unknown'} | ${node.status || 'unknown'}`;
            }

            function applyStatus(status) {
                const running = Boolean(status && status.running);
                chip.textContent = running ? 'RUNNING' : 'OFFLINE';
                chip.classList.toggle('running', running);
                chip.classList.toggle('offline', !running);

                frontendEl.textContent = `frontend: ${shortState(status && status.frontend)}`;
                renderEl.textContent = `render: ${shortState(status && status.render)}`;
                fastapiEl.textContent = `fastapi: ${shortState(status && status.fastapi)}`;

                if (running) {
                    note.textContent = 'Stack activo. Editor disponible en iframe y nueva pestana.';
                    if (frame.src === 'about:blank' || frame.src.endsWith('/blank')) {
                        frame.src = `${proxyPath}/`;
                    }
                } else {
                    note.textContent = 'Stack detenido. Usa Start para levantar contenedores.';
                    frame.src = 'about:blank';
                }

                openNew.href = `${proxyPath}/`;
            }

            async function requestJson(url, options) {
                const response = await fetch(url, options);
                const payload = await response.json().catch(() => ({}));
                if (!response.ok || payload.ok === false) {
                    throw new Error(payload.error || `request_failed_${response.status}`);
                }
                return payload;
            }

            async function refreshStatus() {
                try {
                    const payload = await requestJson('/tools/remotion-studio/status', { cache: 'no-store' });
                    applyStatus(payload.status || {});
                } catch (error) {
                    note.textContent = `No se pudo leer estado: ${error.message}`;
                }
            }

            async function runAction(endpoint, runningMessage) {
                if (pendingAction) return;

                try {
                    setBusy(true);
                    note.textContent = runningMessage;
                    const payload = await requestJson(endpoint, { method: 'POST' });
                    applyStatus(payload.status || {});
                } catch (error) {
                    note.textContent = `Operacion fallida: ${error.message}`;
                } finally {
                    setBusy(false);
                }
            }

            startBtn.addEventListener('click', function () {
                runAction('/tools/remotion-studio/start', 'Levantando Docker stack...');
            });

            restartBtn.addEventListener('click', function () {
                runAction('/tools/remotion-studio/restart', 'Reiniciando Docker stack...');
            });

            stopBtn.addEventListener('click', function () {
                if (!window.confirm('Detener Kimu Video Editor?')) return;
                runAction('/tools/remotion-studio/stop', 'Deteniendo Docker stack...');
            });

            refreshBtn.addEventListener('click', function () {
                if (frame.src !== 'about:blank') {
                    frame.src = frame.src;
                }
                refreshStatus();
            });

            applyStatus(<%- JSON.stringify(veStatus || {}) %>);
            refreshStatus();
            setInterval(refreshStatus, 12000);
        })();
    </script>
</body>
</html>
